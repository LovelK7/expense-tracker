{
  "name": "troskovi-rules-tests",
  "private": true,
  "description": "Firestore security rules tests (run against the local Firestore emulator).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-troskovi --config ../../firebase.json \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0"
  }
}
