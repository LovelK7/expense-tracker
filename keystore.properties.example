# Release signing for local builds. Copy to private/keystore.properties (private/ is never
# committed) and fill in. storeFile is relative to the app/ module, so ../private/release.jks is
# <repo>/private/release.jks. The release workflow uses the TROSKOVI_* environment variables
# instead (README "Releases").
storeFile=../private/release.jks
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=troskovi
